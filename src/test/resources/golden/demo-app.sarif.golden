{
  "$schema" : "https://json.schemastore.org/sarif-2.1.0.json",
  "version" : "2.1.0",
  "runs" : [ {
    "tool" : {
      "driver" : {
        "name" : "sprig",
        "version" : "dev",
        "informationUri" : "https://github.com/vianbas/sprig",
        "rules" : [ {
          "id" : "SPR-CONFIG-001",
          "name" : "actuator-exposure",
          "shortDescription" : {
            "text" : "Spring Boot Actuator exposes sensitive endpoint(s): *, env, heapdump, or shutdown."
          },
          "fullDescription" : {
            "text" : "Spring Boot Actuator exposes sensitive endpoint(s): *, env, heapdump, or shutdown."
          },
          "help" : {
            "text" : "Limit management.endpoints.web.exposure.include to safe endpoints (health, info) or expose management over a non-public port with authentication."
          },
          "helpUri" : "https://github.com/vianbas/sprig/blob/main/docs/rules/SPR-CONFIG-001.md",
          "properties" : {
            "tags" : [ "actuator", "config", "info-exposure" ],
            "precision" : "high",
            "security-severity" : "7.0"
          }
        }, {
          "id" : "SPR-CONFIG-002",
          "name" : "hardcoded-secret",
          "shortDescription" : {
            "text" : "A credential-like property is set to a literal value in configuration."
          },
          "fullDescription" : {
            "text" : "A credential-like property is set to a literal value in configuration."
          },
          "help" : {
            "text" : "Move secrets to environment variables or a secret manager and reference them with ${...} placeholders."
          },
          "helpUri" : "https://github.com/vianbas/sprig/blob/main/docs/rules/SPR-CONFIG-002.md",
          "properties" : {
            "tags" : [ "config", "secrets" ],
            "precision" : "high",
            "security-severity" : "5.0"
          }
        }, {
          "id" : "SPR-CONFIG-003",
          "name" : "insecure-cookie-flags",
          "shortDescription" : {
            "text" : "Session cookie flags http-only or secure are explicitly disabled."
          },
          "fullDescription" : {
            "text" : "Session cookie flags http-only or secure are explicitly disabled."
          },
          "help" : {
            "text" : "Set server.servlet.session.cookie.http-only=true and server.servlet.session.cookie.secure=true (secure especially over HTTPS)."
          },
          "helpUri" : "https://github.com/vianbas/sprig/blob/main/docs/rules/SPR-CONFIG-003.md",
          "properties" : {
            "tags" : [ "config", "cookies", "session" ],
            "precision" : "high",
            "security-severity" : "5.0"
          }
        }, {
          "id" : "SPR-CONFIG-004",
          "name" : "cors-config-wildcard-credentials",
          "shortDescription" : {
            "text" : "CORS configured with allowed-origins=* and allow-credentials=true in application configuration."
          },
          "fullDescription" : {
            "text" : "CORS configured with allowed-origins=* and allow-credentials=true in application configuration."
          },
          "help" : {
            "text" : "List the permitted origins explicitly when allow-credentials=true; never combine '*' with credentials."
          },
          "helpUri" : "https://github.com/vianbas/sprig/blob/main/docs/rules/SPR-CONFIG-004.md",
          "properties" : {
            "tags" : [ "config", "cors" ],
            "precision" : "high",
            "security-severity" : "7.0"
          }
        }, {
          "id" : "SPR-CONFIG-005",
          "name" : "security-debug-enabled",
          "shortDescription" : {
            "text" : "Spring Security logging is set to DEBUG or TRACE, which can leak request and principal internals in production."
          },
          "fullDescription" : {
            "text" : "Spring Security logging is set to DEBUG or TRACE, which can leak request and principal internals in production."
          },
          "help" : {
            "text" : "Raise the level to INFO or above, or scope the DEBUG level to a dev-only profile."
          },
          "helpUri" : "https://github.com/vianbas/sprig/blob/main/docs/rules/SPR-CONFIG-005.md",
          "properties" : {
            "tags" : [ "config", "logging" ],
            "precision" : "high",
            "security-severity" : "3.0"
          }
        }, {
          "id" : "SPR-CORS-001",
          "name" : "cors-wildcard-credentials",
          "shortDescription" : {
            "text" : "@CrossOrigin with origins=\"*\" and allowCredentials=\"true\" allows any origin to send credentialed requests."
          },
          "fullDescription" : {
            "text" : "@CrossOrigin with origins=\"*\" and allowCredentials=\"true\" allows any origin to send credentialed requests."
          },
          "help" : {
            "text" : "Restrict origins to an explicit allowlist (never '*') and keep allowCredentials=true only with specific origins."
          },
          "helpUri" : "https://github.com/vianbas/sprig/blob/main/docs/rules/SPR-CORS-001.md",
          "properties" : {
            "tags" : [ "cors", "source" ],
            "precision" : "high",
            "security-severity" : "7.0"
          }
        }, {
          "id" : "SPR-SRC-002",
          "name" : "noop-password-encoder",
          "shortDescription" : {
            "text" : "NoOpPasswordEncoder or a {noop} password stores passwords as plaintext."
          },
          "fullDescription" : {
            "text" : "NoOpPasswordEncoder or a {noop} password stores passwords as plaintext."
          },
          "help" : {
            "text" : "Use a strong hashing encoder such as BCryptPasswordEncoder (or DelegatingPasswordEncoder with bcrypt) and re-hash stored passwords."
          },
          "helpUri" : "https://github.com/vianbas/sprig/blob/main/docs/rules/SPR-SRC-002.md",
          "properties" : {
            "tags" : [ "auth", "password", "source" ],
            "precision" : "high",
            "security-severity" : "7.0"
          }
        }, {
          "id" : "SPR-SRC-003",
          "name" : "permit-all-request-matcher",
          "shortDescription" : {
            "text" : "SecurityFilterChain permits every request via anyRequest().permitAll() with no authentication mechanism."
          },
          "fullDescription" : {
            "text" : "SecurityFilterChain permits every request via anyRequest().permitAll() with no authentication mechanism."
          },
          "help" : {
            "text" : "Replace .anyRequest().permitAll() with .anyRequest().authenticated() (or a role-based rule) and add an authentication mechanism such as httpBasic, formLogin, or oauth2ResourceServer."
          },
          "helpUri" : "https://github.com/vianbas/sprig/blob/main/docs/rules/SPR-SRC-003.md",
          "properties" : {
            "tags" : [ "auth", "source" ],
            "precision" : "high",
            "security-severity" : "7.0"
          }
        }, {
          "id" : "SPR-SRC-004",
          "name" : "missing-method-security",
          "shortDescription" : {
            "text" : "@EnableWebSecurity without @EnableMethodSecurity: method security annotations such as @PreAuthorize are not enforced."
          },
          "fullDescription" : {
            "text" : "@EnableWebSecurity without @EnableMethodSecurity: method security annotations such as @PreAuthorize are not enforced."
          },
          "help" : {
            "text" : "Add @EnableMethodSecurity (or @EnableGlobalMethodSecurity) to a @Configuration class to activate method-level authorization."
          },
          "helpUri" : "https://github.com/vianbas/sprig/blob/main/docs/rules/SPR-SRC-004.md",
          "properties" : {
            "tags" : [ "auth", "source" ],
            "precision" : "high",
            "security-severity" : "5.0"
          }
        }, {
          "id" : "SPR-SRC-005",
          "name" : "frame-options-disabled",
          "shortDescription" : {
            "text" : "headers().frameOptions() is disabled, removing clickjacking protection."
          },
          "fullDescription" : {
            "text" : "headers().frameOptions() is disabled, removing clickjacking protection."
          },
          "help" : {
            "text" : "Keep frameOptions() at its default (DENY) or set SAMEORIGIN if the app must be framed by itself."
          },
          "helpUri" : "https://github.com/vianbas/sprig/blob/main/docs/rules/SPR-SRC-005.md",
          "properties" : {
            "tags" : [ "clickjacking", "headers", "source" ],
            "precision" : "high",
            "security-severity" : "5.0"
          }
        } ]
      }
    },
    "results" : [ {
